<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.adsa.controller.DialogUpdateController">
   <header>
      <VBox prefWidth="100.0">
         <children>
            <Label text="Editar Alumno" />
            <Label fx:id="lblTitleName" text="Modifica los datos de Carlos García Martínez" />
         </children>
      </VBox>
   </header>
   <content>
      <HBox>
         <children>
            <VBox prefWidth="100.0">
               <children>
                  <Label text="Label" />
                  <TextField />
                  <Label text="Label" />
                  <TextField />
                  <Label text="Label" />
                  <ChoiceBox prefWidth="150.0" />
               </children>
            </VBox>
            <VBox prefWidth="100.0">
               <children>
                  <Label text="Label" />
                  <TextField />
                  <Label text="Label" />
                  <TextField />
                  <Label text="Label" />
                  <ChoiceBox prefWidth="150.0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </content>
   <buttonTypes>
      <ButtonType fx:constant="CANCEL" />
      <ButtonType fx:constant="APPLY" />
   </buttonTypes>
</DialogPane>
