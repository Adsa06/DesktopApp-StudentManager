<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.adsa.controller.DialogUpdateController">
   <header>
      <VBox prefWidth="100.0">
         <children>
            <Label text="Editar Alumno" />
            <Label fx:id="lblTitleName" text="Modifica los datos de Carlos García Martínez" />
         </children>
      </VBox>
   </header>
   <content>
      <VBox>
         <children>
            <HBox>
               <children>
                  <VBox prefWidth="100.0">
                     <children>
                        <Label text="Label" />
                        <TextField />
                        <Label text="Label" />
                        <TextField />
                        <Label text="Label" />
                        <ChoiceBox prefWidth="150.0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="100.0">
                     <children>
                        <Label text="Label" />
                        <TextField />
                        <Label text="Label" />
                        <TextField />
                        <Label text="Label" />
                        <ChoiceBox prefWidth="150.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#cancelDialog" text="Cancelar" />
                  <Button mnemonicParsing="false" text="Actualizar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</DialogPane>
