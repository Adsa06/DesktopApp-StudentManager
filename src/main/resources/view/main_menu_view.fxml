<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.adsa.controller.MainMenuController">
   <children>
      <BorderPane fx:id="bpMainMenu" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
         <top>
            <StackPane prefHeight="50.0" style="-fx-background-color: #DDDDDD;" BorderPane.alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" onAction="#closeApp" text="Cerrar" StackPane.alignment="CENTER_LEFT" />
                  <Label text="Gestión de Alumnos" />
                  <Label text="Sistema completo de administración CRUD" StackPane.alignment="BOTTOM_CENTER" />
               </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </StackPane>
         </top>
         <right>
            <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #DDDDDD;" BorderPane.alignment="CENTER">
               <children>
                  <Label text="Filtrar por Ciclo" />
                  <ChoiceBox fx:id="cbFilter" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
                  <Button mnemonicParsing="false" onAction="#applyFilter" text="Aplicar filtro" />
                  <Button mnemonicParsing="false" onAction="#eliminateFilter" text="Eliminar filtro" />
               </children>
            </VBox>
         </right>
         <left>
            <VBox prefHeight="200.0" style="-fx-background-color: #DDDDDD;" BorderPane.alignment="CENTER">
               <children>
                  <Label text="Crear Nuevo Alumno" />
                  <Label text="Sistema completo de administración CRUD" />
                  <Label text="Nombre" />
                  <TextField fx:id="inputName" />
                  <Label text="Apellidos" />
                  <TextField fx:id="inputSurname" />
                  <Label text="Edad" />
                  <TextField fx:id="inputAge" />
                  <Label text="Telefono" />
                  <TextField fx:id="inputPhone" />
                  <Label text="Ciudad" />
                  <ChoiceBox fx:id="cbCity" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
                  <Label text="Ciclo" />
                  <ChoiceBox fx:id="cbCycle" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
                  <Label fx:id="lblAddStudentError" style="-fx-text-fill: #FF0000;" text="Rellene todos los campos" visible="false">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </Label>
                  <Label fx:id="lblAddDuplicatePhoneError" style="-fx-text-fill: #FF0000;" text="Telefono existente" visible="false" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#createStudent" text="Añadir">
                     <VBox.margin>
                        <Insets top="15.0" />
                     </VBox.margin></Button>
               </children>
            </VBox>
         </left>
         <center>
            <VBox BorderPane.alignment="CENTER" prefHeight="0" prefWidth="0">
               <children>
                  <Button mnemonicParsing="false" onAction="#deleteStudent" text="Eliminar selecionados" />
                  <ListView fx:id="studentListView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS"/>
               </children>
            </VBox>
         </center>
      </BorderPane>
      <AnchorPane fx:id="apUpdateForm"
                     maxHeight="1.7976931348623157E308"
                     maxWidth="1.7976931348623157E308"
                     style="-fx-background-color: rgba(0,0,0,0.45);"
                     visible="false">

      <children>
         <StackPane AnchorPane.topAnchor="0"
                  AnchorPane.bottomAnchor="0"
                  AnchorPane.leftAnchor="0"
                  AnchorPane.rightAnchor="0">
         <children>
            <VBox prefWidth="420"
                  spacing="10"
                  alignment="TOP_CENTER"
                  style="-fx-background-color: #ffffff;
                        -fx-padding: 20;
                        -fx-background-radius: 10;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0.2, 0, 5);">

               <children>
                  <!-- TÍTULO -->
                  <Label text="Actualizar Alumno"
                        style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                  <!-- FORMULARIO -->
                  <Label text="Nombre" />
                  <TextField fx:id="formName" />

                  <Label text="Apellidos" />
                  <TextField fx:id="formSurname" />

                  <Label text="Edad" />
                  <TextField fx:id="formAge" />

                  <Label text="Ciudad" />
                  <ChoiceBox fx:id="formCity" maxWidth="Infinity" />

                  <Label text="Ciclo" />
                  <ChoiceBox fx:id="formCycle" maxWidth="Infinity" />

                  <!-- ERROR -->
                  <Label fx:id="lblUpdateStudentError"
                        text="Rellene todos los campos"
                        visible="false"
                        style="-fx-text-fill: #d32f2f; -fx-font-size: 12px;" />

                  <!-- BOTONES -->
                  <HBox spacing="10" alignment="CENTER_RIGHT">
                     <children>
                        <Button mnemonicParsing="false"
                              onAction="#closeDialog"
                              text="Cerrar"
                              style="-fx-background-color: #e0e0e0;" />

                        <Button mnemonicParsing="false"
                              onAction="#updateStudent"
                              text="Actualizar"
                              style="-fx-background-color: #1976d2; -fx-text-fill: white;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>

   </children>
</StackPane>
